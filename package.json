{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "Production-ready full-stack E-commerce platform built with React, Vite, Node.js, Express, and MongoDB",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "client": "npm --prefix frontend run dev",
    "server": "node server/server.js",
    "server:dev": "node --watch server/server.js",
    "build": "npm --prefix frontend run build",
    "start": "node server/server.js",
    "seed": "node server/utils/seed.js",
    "test:e2e": "node server/test_e2e.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
